<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F0F2F5">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="650dp"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_marginVertical="24dp"
        app:cardCornerRadius="12dp"
        app:cardElevation="12dp"
        app:strokeColor="#DDDDDD"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical">

            <!-- HEADER -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="20dp">
                <TextView
                    android:id="@+id/tv_work_order_title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Add Work Order"
                    android:textColor="#1A1A1B"
                    android:textSize="24sp"
                    android:textStyle="bold" />
                <ImageView
                    android:id="@+id/btn_close_activity"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#999999" />
            </RelativeLayout>

            <View android:layout_width="match_parent" android:layout_height="1dp" android:background="#EEEEEE" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="32dp"
                android:paddingTop="32dp"
                android:paddingBottom="16dp">

                <!-- TABS (chỉ hiện với FE) -->
                <LinearLayout
                    android:id="@+id/layout_wo_tabs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/btn_tab_info"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_tab_active"
                        android:gravity="center"
                        android:text="1. Information"
                        android:textColor="@color/white"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/btn_tab_material"
                        android:layout_width="0dp"
                        android:layout_height="40dp"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_tab_inactive"
                        android:gravity="center"
                        android:text="2. Materials"
                        android:textColor="@color/black"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <ViewFlipper
                    android:id="@+id/view_flipper"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- SECTION INFO -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">
                        <GridLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:columnCount="2"
                            android:alignmentMode="alignBounds">

                            <!-- Mã W/O -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tv_label_wo_code"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="W/O Code"
                                    android:textStyle="bold"
                                    android:textColor="#303133"
                                    android:layout_marginBottom="8dp"/>
                                <EditText
                                    android:id="@+id/edt_wo_code"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field_disabled"
                                    android:enabled="false"
                                    android:paddingHorizontal="12dp"
                                    android:hint="W/O Code"
                                    android:text="..."/>
                            </LinearLayout>

                            <!-- Ngày yêu cầu -->
                            <LinearLayout
                                android:id="@+id/layout_request_date"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="8dp">
                                    <TextView
                                        android:id="@+id/tv_label_request_date"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Request Date"
                                        android:textStyle="bold"
                                        android:textColor="#303133"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" *"
                                        android:textColor="#F56C6C"/>
                                </LinearLayout>
                                <EditText
                                    android:id="@+id/edt_request_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field"
                                    android:hint="mm/dd/yyyy --:-- --"
                                    android:paddingHorizontal="12dp"
                                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"
                                    android:focusable="false"/>
                            </LinearLayout>

                            <!-- Máy / Assignee (đổi theo Loại WO: Other -> Assignee) -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">

                                <LinearLayout
                                    android:id="@+id/layout_machine"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="8dp">
                                        <TextView
                                            android:id="@+id/tv_label_machine"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Machine"
                                            android:textStyle="bold"
                                            android:textColor="#303133"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" *"
                                            android:textColor="#F56C6C"/>
                                    </LinearLayout>
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_input_field">
                                        <AutoCompleteTextView
                                            android:id="@+id/auto_machine"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@null"
                                            android:paddingHorizontal="12dp"
                                            android:hint="Select an item"
                                            android:inputType="text" />
                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_alignParentEnd="true"
                                            android:layout_centerVertical="true"
                                            android:layout_marginEnd="12dp"
                                            android:src="@android:drawable/arrow_down_float"
                                            app:tint="#C0C4CC"/>
                                    </RelativeLayout>
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/layout_assignee"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:visibility="gone">
                                    <LinearLayout
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:orientation="horizontal"
                                        android:layout_marginBottom="8dp">
                                        <TextView
                                            android:id="@+id/tv_label_assignee"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Assignee"
                                            android:textStyle="bold"
                                            android:textColor="#303133"/>
                                        <TextView
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text=" *"
                                            android:textColor="#F56C6C"/>
                                    </LinearLayout>
                                    <RelativeLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="48dp"
                                        android:background="@drawable/bg_input_field">
                                        <AutoCompleteTextView
                                            android:id="@+id/auto_assignee"
                                            android:layout_width="match_parent"
                                            android:layout_height="match_parent"
                                            android:background="@null"
                                            android:paddingHorizontal="12dp"
                                            android:hint="Select an item"
                                            android:inputType="none" />
                                        <ImageView
                                            android:layout_width="20dp"
                                            android:layout_height="20dp"
                                            android:layout_alignParentEnd="true"
                                            android:layout_centerVertical="true"
                                            android:layout_marginEnd="12dp"
                                            android:src="@android:drawable/arrow_down_float"
                                            app:tint="#C0C4CC"/>
                                    </RelativeLayout>
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Process -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tv_label_process"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Process"
                                    android:textStyle="bold"
                                    android:textColor="#303133"
                                    android:layout_marginBottom="8dp"/>
                                <EditText
                                    android:id="@+id/edt_process"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field"
                                    android:paddingHorizontal="12dp"
                                    android:hint="Enter process"/>
                            </LinearLayout>

                            <!-- Loại hình -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="8dp">
                                    <TextView
                                        android:id="@+id/tv_label_type"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Type"
                                        android:textStyle="bold"
                                        android:textColor="#303133"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" *"
                                        android:textColor="#F56C6C"/>
                                </LinearLayout>
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field">
                                    <AutoCompleteTextView
                                        android:id="@+id/auto_loai_hinh"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="12dp"
                                        android:hint="Select type"
                                        android:inputType="none" />
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginEnd="12dp"
                                        android:src="@android:drawable/arrow_down_float"
                                        app:tint="#C0C4CC"/>
                                </RelativeLayout>
                            </LinearLayout>

                            <!-- Người yêu cầu -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="8dp">
                                    <TextView
                                        android:id="@+id/tv_label_requester"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Requester"
                                        android:textStyle="bold"
                                        android:textColor="#303133"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" *"
                                        android:textColor="#F56C6C"/>
                                </LinearLayout>
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field">
                                    <AutoCompleteTextView
                                        android:id="@+id/auto_requester"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="12dp"
                                        android:hint="Requester"
                                        android:inputType="text" />
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginEnd="12dp"
                                        android:src="@android:drawable/arrow_down_float"
                                        app:tint="#C0C4CC"/>
                                </RelativeLayout>
                            </LinearLayout>



                            <!-- Ngày trải qua -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tv_label_passed_date"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Passed Date"
                                    android:textStyle="bold"
                                    android:textColor="#303133"
                                    android:layout_marginBottom="8dp"/>
                                <EditText
                                    android:id="@+id/edt_passed_date"
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field"
                                    android:paddingHorizontal="12dp"
                                    android:hint="Enter passed date"/>
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_mes_lock"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tv_label_mes_lock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="Is there a device lock feature on the MES system?"
                                    android:textStyle="bold"
                                    android:textColor="#303133"
                                    android:layout_marginBottom="8dp"/>

                                <RadioGroup
                                    android:id="@+id/radio_group_mes_lock"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal">

                                    <RadioButton
                                        android:id="@+id/radio_mes_lock_yes"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Yes"
                                        android:textColor="#303133"
                                        android:buttonTint="#00A680"/>

                                    <RadioButton
                                        android:id="@+id/radio_mes_lock_no"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_marginStart="24dp"
                                        android:text="No"
                                        android:textColor="#303133"
                                        android:buttonTint="#00A680"/>
                                </RadioGroup>

                            </LinearLayout>

                            <!-- Deadline -->
<!--                            <LinearLayout-->
<!--                                android:layout_width="0dp"-->
<!--                                android:layout_height="wrap_content"-->
<!--                                android:layout_columnWeight="1"-->
<!--                                android:layout_margin="8dp"-->
<!--                                android:orientation="vertical">-->
<!--                                <TextView-->
<!--                                    android:id="@+id/tv_label_deadline"-->
<!--                                    android:layout_width="wrap_content"-->
<!--                                    android:layout_height="wrap_content"-->
<!--                                    android:text="Deadline"-->
<!--                                    android:textStyle="bold"-->
<!--                                    android:textColor="#303133"-->
<!--                                    android:layout_marginBottom="8dp"/>-->
<!--                                <EditText-->
<!--                                    android:id="@+id/edt_deadline"-->
<!--                                    android:layout_width="match_parent"-->
<!--                                    android:layout_height="48dp"-->
<!--                                    android:background="@drawable/bg_input_field"-->
<!--                                    android:hint="mm/dd/yyyy &#45;&#45;:&#45;&#45; &#45;&#45;"-->
<!--                                    android:paddingHorizontal="12dp"-->
<!--                                    android:drawableEnd="@android:drawable/ic_menu_my_calendar"-->
<!--                                    android:focusable="false"/>-->
<!--                            </LinearLayout>-->

                            <!-- Lý do yêu cầu -->
                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnSpan="2"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <LinearLayout
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:orientation="horizontal"
                                    android:layout_marginBottom="8dp">
                                    <TextView
                                        android:id="@+id/tv_label_request_reason"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Work Order Content"
                                        android:textStyle="bold"
                                        android:textColor="#303133"/>
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text=" *"
                                        android:textColor="#F56C6C"/>
                                </LinearLayout>
                                <EditText
                                    android:id="@+id/edt_reason"
                                    android:layout_width="match_parent"
                                    android:layout_height="100dp"
                                    android:background="@drawable/bg_input_field"
                                    android:gravity="top"
                                    android:padding="12dp"
                                    android:hint="Enter work order content"/>
                            </LinearLayout>

                            <!-- Trạng thái MA báo -->
                            <LinearLayout
                                android:id="@+id/layout_ma_status"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_columnSpan="2"
                                android:layout_columnWeight="1"
                                android:layout_margin="8dp"
                                android:orientation="vertical">
                                <TextView
                                    android:id="@+id/tv_label_ma_status"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="MA Status"
                                    android:textStyle="bold"
                                    android:textColor="#303133"
                                    android:layout_marginBottom="8dp"/>
                                <RelativeLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="48dp"
                                    android:background="@drawable/bg_input_field">
                                    <AutoCompleteTextView
                                        android:id="@+id/auto_ma_status"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@null"
                                        android:paddingHorizontal="12dp"
                                        android:hint="Select an item"
                                        android:inputType="none" />
                                    <ImageView
                                        android:layout_width="20dp"
                                        android:layout_height="20dp"
                                        android:layout_alignParentEnd="true"
                                        android:layout_centerVertical="true"
                                        android:layout_marginEnd="12dp"
                                        android:src="@android:drawable/arrow_down_float"
                                        app:tint="#C0C4CC"/>
                                </RelativeLayout>
                            </LinearLayout>
                        </GridLayout>

                        <!-- ATTACHMENT (ảnh đính kèm) -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_margin="8dp"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tv_label_attachment"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Attachment"
                                android:textStyle="bold"
                                android:textColor="#303133"
                                android:layout_marginBottom="8dp" />

                            <!-- Choose File & Upload buttons -->
                            <LinearLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginBottom="10dp"
                                android:orientation="horizontal">

                                <LinearLayout
                                    android:id="@+id/btn_choose_file"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_btn_choose_file"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:layout_marginEnd="6dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:src="@drawable/ic_paperclip" />

                                    <TextView
                                        android:id="@+id/tv_choose_file"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Choose File"
                                        android:textColor="#01A789"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>

                                <LinearLayout
                                    android:id="@+id/btn_upload_file"
                                    android:layout_width="0dp"
                                    android:layout_height="40dp"
                                    android:layout_weight="1"
                                    android:background="@drawable/bg_tab_active"
                                    android:gravity="center"
                                    android:orientation="horizontal"
                                    android:paddingHorizontal="8dp"
                                    android:clickable="true"
                                    android:focusable="true">

                                    <ImageView
                                        android:layout_width="16dp"
                                        android:layout_height="16dp"
                                        android:layout_marginEnd="4dp"
                                        android:src="@drawable/ic_upload" />

                                    <TextView
                                        android:id="@+id/tv_upload_file"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="Upload"
                                        android:textColor="@color/white"
                                        android:textSize="12sp"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </LinearLayout>

                            <!-- Khu vực hiển thị file (màn Thêm: 1 khối duy nhất) -->
                            <LinearLayout
                                android:id="@+id/layout_attachment_single"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="#F4F6F9"
                                android:orientation="vertical"
                                android:padding="12dp">

                                <!-- Placeholder khi chưa có file -->
                                <LinearLayout
                                    android:id="@+id/layout_attachment_empty"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:gravity="center"
                                    android:orientation="horizontal">

                                    <ImageView
                                        android:layout_width="18dp"
                                        android:layout_height="18dp"
                                        android:layout_marginEnd="8dp"
                                        android:src="@drawable/ic_folder" />

                                    <TextView
                                        android:id="@+id/tv_attachment_status"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="No attachment file"
                                        android:textColor="#808080"
                                        android:textSize="13sp"
                                        android:textStyle="italic" />
                                </LinearLayout>

                                <!-- Danh sách file đính kèm (mỗi file 1 dòng kèm nút X) -->
                                <LinearLayout
                                    android:id="@+id/layout_attachment_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:orientation="vertical"
                                    android:visibility="gone" />
                            </LinearLayout>

                            <!-- Màn Sửa WO: 2 khối riêng Tài liệu MA / Tài liệu FE (giống web) -->
                            <LinearLayout
                                android:id="@+id/layout_doc_ma_block"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tv_label_doc_ma"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="6dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="MA Documents"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/layout_doc_ma_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#F4F6F9"
                                    android:orientation="vertical"
                                    android:padding="12dp" />
                            </LinearLayout>

                            <LinearLayout
                                android:id="@+id/layout_doc_fe_block"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:visibility="gone">

                                <TextView
                                    android:id="@+id/tv_label_doc_fe"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="10dp"
                                    android:layout_marginBottom="4dp"
                                    android:text="FE Documents"
                                    android:textColor="#475569"
                                    android:textSize="12sp"
                                    android:textStyle="bold" />

                                <LinearLayout
                                    android:id="@+id/layout_doc_fe_list"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:background="#F4F6F9"
                                    android:orientation="vertical"
                                    android:padding="12dp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <!-- SECTION MATERIAL (FE) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <!-- Materials table header -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="4dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tv_material_header_name"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="2.4"
                                android:layout_marginEnd="6dp"
                                android:text="Materials"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_material_header_stock"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:gravity="center"
                                android:text="Stock"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_material_header_qty"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:layout_marginEnd="6dp"
                                android:gravity="center"
                                android:text="Quantity"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tv_material_header_func"
                                android:layout_width="64dp"
                                android:layout_height="wrap_content"
                                android:gravity="center"
                                android:text="Function"
                                android:textColor="#475569"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:id="@+id/layout_material_rows"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical" />

                        <TextView
                            android:id="@+id/btn_add_material"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:background="@drawable/bg_btn_choose_file"
                            android:clickable="true"
                            android:focusable="true"
                            android:paddingHorizontal="16dp"
                            android:paddingVertical="10dp"
                            android:text="+ Add material"
                            android:textColor="#01A789"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </ViewFlipper>

            </LinearLayout>
            </ScrollView>

            <!-- FOOTER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="32dp"
                android:paddingTop="16dp"
                android:paddingBottom="24dp">
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_add"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="50dp"
                    android:backgroundTint="#00A680"
                    android:text="Add"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="6dp" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
