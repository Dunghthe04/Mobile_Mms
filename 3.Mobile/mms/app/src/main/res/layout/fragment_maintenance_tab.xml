<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/swipe_refresh_maintenance"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9FAFB">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F0Fdf4"
            android:paddingHorizontal="16dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tv_maintenance_summary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Periodic Maintenance Task List"
                android:textColor="#00A680"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="DANH SÁCH NHIỆM VỤ BẢO DƯỠNG" />
        </RelativeLayout>

        <!-- RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_maintenance_tasks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="10dp"
            android:paddingVertical="8dp"
            android:scrollbars="vertical"
            tools:listitem="@layout/item_maintenance_plan_card" />

    </LinearLayout>

</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>